# Copy this file to .env and fill in your credentials
# Required:
EPIC_EMAIL=you@example.com
EPIC_PASSWORD=yourpassword

# Optional:
# Discord webhook to receive notifications when claims succeed/fail
DISCORD_WEBHOOK_URL=

# Run browser in headless mode by default. Set to 'false' to see the browser.
HEADLESS=true

# Take screenshots on error. Set to 'false' to disable.
SCREENSHOT_ON_ERROR=true

# Logging level: debug, info, warn, error
LOG_LEVEL=info
