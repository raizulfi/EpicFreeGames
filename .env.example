# Epic Games Credentials (not required if using Firefox profile mode)
EPIC_EMAIL=your_email@example.com
EPIC_PASSWORD=your_password

# Firefox Profile Mode (optional - alternative to credentials above)
# Set to true to use your Firefox profile instead of email/password login
# This skips CAPTCHA and uses your existing logged-in session
USE_FIREFOX_PROFILE=false
FIREFOX_PROFILE_PATH=C:\Users\YourUsername\AppData\Roaming\Mozilla\Firefox\Profiles\YOUR_PROFILE_ID

# Browser Settings
HEADLESS=true
SCREENSHOT_ON_ERROR=true
SCREENSHOT_ON_SUCCESS=false
BROWSER_TIMEOUT=30000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=2000
EXPONENTIAL_BACKOFF=true

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Advanced Options
PROXY_URL=
USER_AGENT=
SESSION_DIR=./sessions
CLOSE_BROWSER_ON_ERROR=true
CAPTCHA_TIMEOUT=300000
