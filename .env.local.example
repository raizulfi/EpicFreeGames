# Development environment configuration
# Copy this to .env.local for local development

EPIC_EMAIL=dev@example.com
EPIC_PASSWORD=dev_password_123

# Browser settings
HEADLESS=false
SCREENSHOT_ON_ERROR=true
SCREENSHOT_ON_SUCCESS=true
BROWSER_TIMEOUT=30000

# Retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=2000
EXPONENTIAL_BACKOFF=true

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Notifications
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Advanced
PROXY_URL=
USER_AGENT=
SESSION_DIR=./sessions
CLOSE_BROWSER_ON_ERROR=true
CAPTCHA_TIMEOUT=300000
